{
  "name": "muscleos",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "biome lint --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "dev": "turbo run dev",
    "dev:landing": "pnpm --filter landing dev",
    "supabase": "node scripts/supabase.mjs",
    "supabase:link": "node scripts/supabase.mjs link",
    "supabase:migrate": "node scripts/supabase.mjs db push",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "supabase": "^2.115.0",
    "turbo": "^2.10.12"
  },
  "engines": {
    "node": ">=24"
  }
}
