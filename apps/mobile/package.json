{
  "name": "mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --diagnostic-level=error .",
    "test": "vitest run && jest --ci",
