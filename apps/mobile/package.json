    "@types/jest": "^29.5.0",
    "@types/react": "~19.2.14",
    "babel-preset-expo": "~57.0.15",
    "dotenv": "^16.4.5",
    "expo-mcp": "^0.2.4",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~7.0.2",
    "vitest": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
