    "clean": "rm -rf .expo node_modules",
    "generate:catalog": "node scripts/generate-exercise-catalog.mjs",
    "eas-build-post-install": "cd ../.. && pnpm run build --filter @muscleos/types",
    "test:ui": "jest",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/metro-runtime": "^57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@muscleos/types": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@supabase/supabase-js": "^2.98.0",
    "expo": "~57.0.28",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-body-highlighter": "^3.1.4",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.2"
