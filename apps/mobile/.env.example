# Copy to .env and fill in your values. .env is gitignored.
# Required for Supabase auth (sign-in, anonymous sessions):
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Google Sign-In (Android native + iOS browser). Web client ID, not the Android client.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
