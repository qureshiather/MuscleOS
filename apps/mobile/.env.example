# Copy to .env and fill in your values. .env is gitignored.
# Required for Supabase auth (sign-in, anonymous sessions):
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: RevenueCat (in-app purchases) — use platform keys for store builds
# iOS public key (appl_…):
# EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
# Android public key (goog_…):
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
# Legacy fallback (avoid on production; set platform keys above):
# EXPO_PUBLIC_REVENUECAT_API_KEY=

# Optional: Google OAuth (if using Google sign-in)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
